{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "browser/**/*.ts",
    "browser.ts",
    "../abi/**/*.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "tests/*.spec.ts",
    "tests/command-buffer.ts",
    "tests/static_server.ts",
    "tests/fixtures/smoke/harness.ts"
  ]
}
